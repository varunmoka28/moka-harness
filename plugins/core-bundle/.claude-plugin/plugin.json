    "clean-view",
    "idea-shelf",
    "noticeboard",
    "band-frame",
    "session-peers",
    "strict-guard",
    "terminal-desk",
    "side-chat",
    "layman",
    "big-read-guard",
    "superpowers",
    "ponytail",
    "scope-guard",
    "smart-compact",
    "micro-compaction",
    "cache-tax",
    "secret-box",
    "human-in-the-loop",
    "modwall",
    "claude-code-setup",
    "mod-scout",
    "clawd-spinner",
    "unlazy",
    "pocock-skills",
    "debug-agent",
    "health",
    "tare",
